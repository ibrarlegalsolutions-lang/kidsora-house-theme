{%- liquid
  assign seconds_per_day = 86400
  assign now = 'now' | date: '%s' | plus: 0
  assign from_ts = block.settings.min_days | times: seconds_per_day | plus: now
  assign to_ts = block.settings.max_days | times: seconds_per_day | plus: now
  case block.settings.date_format
    when 'short'
      assign strftime = '%a %-d %b'
    when 'numeric'
      assign strftime = '%-d/%-m/%Y'
    else
      assign strftime = '%A, %B %-d'
  endcase
  assign from_date = from_ts | date: strftime
  assign to_date = to_ts | date: strftime
-%}

<div
  class="zx-delivery"
  data-min-days="{{ block.settings.min_days }}"
  data-max-days="{{ block.settings.max_days }}"
  data-format="{{ block.settings.date_format }}"
  {{ block.shopify_attributes }}
>
  <span class="zx-delivery__icon" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 6h13v10H1zM14 10h5l4 4v2h-9z"/><circle cx="5.5" cy="18" r="2"/><circle cx="18.5" cy="18" r="2"/></svg>
  </span>
  <div class="zx-delivery__body">
    {%- if block.settings.heading != blank -%}
      <p class="zx-delivery__heading">{{ block.settings.heading }}</p>
    {%- endif -%}
    <p class="zx-delivery__dates" data-template="{{ 'content.zx_delivery_between' | t: from: '[from]', to: '[to]' | escape }}">
      {{ 'content.zx_delivery_between' | t: from: from_date, to: to_date }}
    </p>
  </div>
</div>

{% javascript %}
  (() => {
    const formats = {
      long: { weekday: 'long', month: 'long', day: 'numeric' },
      short: { weekday: 'short', day: 'numeric', month: 'short' },
      numeric: { day: 'numeric', month: 'numeric', year: 'numeric' },
    };
    const refresh = () => {
      document.querySelectorAll('.zx-delivery').forEach((el) => {
        const dates = el.querySelector('.zx-delivery__dates');
        if (!dates || !dates.dataset.template) return;
        const locale = document.documentElement.lang || undefined;
        const options = formats[el.dataset.format] || formats.long;
        const at = (days) => {
          const d = new Date();
          d.setDate(d.getDate() + Number(days || 0));
          return d.toLocaleDateString(locale, options);
        };
        dates.textContent = dates.dataset.template
          .replace('[from]', at(el.dataset.minDays))
          .replace('[to]', at(el.dataset.maxDays));
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', refresh, { once: true });
    } else {
      refresh();
    }
    document.addEventListener('shopify:block:select', refresh);
    document.addEventListener('shopify:section:load', refresh);
  })();
{% endjavascript %}

{% stylesheet %}
  .zx-delivery {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--color-border, #e5e5e5);
    font-size: 12px;
  }

  .zx-delivery__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #fff;
    background: #111;
  }

  .zx-delivery__heading {
    margin: 0 0 2px;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--zx-muted, #6b6b6b);
  }

  .zx-delivery__dates {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:zx_names.delivery_estimate",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:zx_settings.heading",
      "default": "Expected delivery"
    },
    {
      "type": "range",
      "id": "min_days",
      "label": "t:zx_settings.min_days",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "max_days",
      "label": "t:zx_settings.max_days",
      "min": 1,
      "max": 45,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "date_format",
      "label": "t:zx_settings.date_format",
      "options": [
        { "value": "long", "label": "t:zx_options.date_long" },
        { "value": "short", "label": "t:zx_options.date_short" },
        { "value": "numeric", "label": "t:zx_options.date_numeric" }
      ],
      "default": "long"
    }
  ],
  "presets": [
    {
      "name": "t:zx_names.delivery_estimate",
      "category": "t:zx_names.category"
    }
  ]
}
{% endschema %}
