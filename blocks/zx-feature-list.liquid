<div class="zx-features zx-features--{{ block.settings.style }}" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}<h2 class="zx-features__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
  <ul class="zx-features__list" role="list">
    {%- content_for 'blocks' -%}
  </ul>
</div>

{% stylesheet %}
  .zx-features { color: var(--zx-ink, #3a080a); }
  .zx-features__heading { margin: 0 0 16px; font-family: var(--font-subheading--family); font-size: 16px; line-height: 18px; font-weight: 400; text-transform: uppercase; letter-spacing: .5px; }
  .zx-features__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .zx-features--perks .zx-features__heading { font-size: 18px; }
{% endstylesheet %}

{% schema %}
{
  "name": "ZX Feature list",
  "blocks": [{ "type": "_zx-feature-row" }],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover the magic!" },
    { "type": "select", "id": "style", "label": "Style", "default": "features", "options": [
      { "value": "features", "label": "Features" }, { "value": "perks", "label": "Perks" }
    ] }
  ],
  "presets": [
    {
      "name": "ZX Feature list",
      "category": "Product",
      "blocks": {
        "row_1": { "type": "_zx-feature-row", "settings": { "icon": "drop", "text": "Describe your first key benefit" } },
        "row_2": { "type": "_zx-feature-row", "settings": { "icon": "clock", "text": "Describe your second key benefit" } },
        "row_3": { "type": "_zx-feature-row", "settings": { "icon": "sparkle", "text": "Describe your third key benefit" } }
      },
      "block_order": ["row_1", "row_2", "row_3"]
    }
  ]
}
{% endschema %}
