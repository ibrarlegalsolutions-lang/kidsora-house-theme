{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 10,
            "show_inventory_quantity": false
          }
        },
        "whatsapp": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'zx-whatsapp-order', product: product %}"
          }
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping",
            "icon": "none",
            "content": "<p>We deliver nationwide across Pakistan. Orders over Rs. 10,000 qualify for free shipping; smaller orders carry a standard delivery charge calculated at checkout.</p>",
            "page": ""
          }
        },
        "returns": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Order & Returns",
            "icon": "none",
            "content": "<p>Unstitched pieces can be returned or exchanged within our refund policy window if unworn and in original packaging. See our Refund Policy page for full details.</p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "inventory",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "whatsapp",
        "description",
        "shipping",
        "returns",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "stacked",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "breadcrumbs": {
      "type": "zx-breadcrumbs",
      "settings": {
        "color_scheme": "scheme-1",
        "padding_top": 16,
        "padding_bottom": 0
      }
    }
  },
  "order": [
    "breadcrumbs",
    "main",
    "disclosures",
    "related-products"
  ]
}
