{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .zx-dual-banner {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr));
    gap: {{ section.settings.gap }}px;
  }

  .zx-dual-banner__item {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: {{ section.settings.aspect_ratio }};
    background: rgba(var(--color-foreground), 0.04);
    color: #fff;
    text-decoration: none;
  }

  .zx-dual-banner__item img,
  .zx-dual-banner__item svg.placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-long) ease;
  }

  a.zx-dual-banner__item:hover img {
    transform: scale(1.03);
  }

  .zx-dual-banner__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.4rem 1.6rem;
    text-align: center;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0));
  }

  .zx-dual-banner__heading {
    margin: 0;
    color: #fff;
    font-size: calc(var(--font-heading-scale) * 2rem);
    letter-spacing: 0.1rem;
    text-transform: uppercase;
  }

  .zx-dual-banner__cta {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 1.2rem;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  a.zx-dual-banner__item:focus-visible {
    outline: 0.2rem solid rgb(var(--color-foreground));
    outline-offset: 0.3rem;
  }

  @media screen and (max-width: 749px) {
    .zx-dual-banner--stack {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zx-dual-banner__item img {
      transition: none;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="{% if section.settings.full_width %}page-width--full{% else %}page-width{% endif %} section-{{ section.id }}-padding">
    <div class="zx-dual-banner{% if section.settings.stack_on_mobile %} zx-dual-banner--stack{% endif %}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
        -%}
        <{{ tag }}
          class="zx-dual-banner__item"
          {% if tag == 'a' %}
            href="{{ block.settings.link }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1500
              | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 1100, 1500',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: block.settings.image.alt | default: block.settings.heading
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- if block.settings.heading != blank or block.settings.cta != blank -%}
            <div class="zx-dual-banner__caption">
              {%- if block.settings.heading != blank -%}
                <h3 class="zx-dual-banner__heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.cta != blank -%}
                <span class="zx-dual-banner__cta">{{ block.settings.cta | escape }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Dual image banner",
  "tag": "section",
  "class": "section zx-dual-banner-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 3,
  "settings": [
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image shape",
      "options": [
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "16 / 9", "label": "Landscape" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between images",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "Stack images on mobile",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Link text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dual image banner",
      "blocks": [{ "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
