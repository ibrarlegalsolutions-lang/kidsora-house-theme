{%- style -%}
  .zx-breadcrumbs {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .zx-breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.65);
  }

  .zx-breadcrumbs__item + .zx-breadcrumbs__item::before {
    content: '/';
    margin: 0 0.8rem;
    color: rgba(var(--color-foreground), 0.4);
  }

  .zx-breadcrumbs__link {
    color: inherit;
    text-decoration: none;
  }

  .zx-breadcrumbs__link:hover {
    color: rgb(var(--color-foreground));
    text-decoration: underline;
  }

  .zx-breadcrumbs__item[aria-current] {
    color: rgb(var(--color-foreground));
  }
{%- endstyle -%}

{%- liquid
  assign parent_collection = collection
  if template.name == 'product' and parent_collection == blank and product.collections.size > 0
    assign parent_collection = product.collections.first
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <nav class="zx-breadcrumbs page-width" aria-label="{{ 'general.breadcrumbs.label' | t }}">
    <ol class="zx-breadcrumbs__list">
      <li class="zx-breadcrumbs__item">
        <a class="zx-breadcrumbs__link" href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
      </li>
      {%- case template.name -%}
        {%- when 'product' -%}
          {%- if parent_collection != blank -%}
            <li class="zx-breadcrumbs__item">
              <a class="zx-breadcrumbs__link" href="{{ parent_collection.url }}">{{ parent_collection.title | escape }}</a>
            </li>
          {%- endif -%}
          <li class="zx-breadcrumbs__item" aria-current="page">{{ product.title | escape }}</li>
        {%- when 'collection' -%}
          {%- if current_tags -%}
            <li class="zx-breadcrumbs__item">
              <a class="zx-breadcrumbs__link" href="{{ collection.url }}">{{ collection.title | escape }}</a>
            </li>
            <li class="zx-breadcrumbs__item" aria-current="page">{{ current_tags | join: ' + ' | escape }}</li>
          {%- else -%}
            <li class="zx-breadcrumbs__item" aria-current="page">{{ collection.title | escape }}</li>
          {%- endif -%}
        {%- when 'search' -%}
          <li class="zx-breadcrumbs__item" aria-current="page">{{ 'general.search.search' | t }}</li>
        {%- else -%}
          <li class="zx-breadcrumbs__item" aria-current="page">{{ page_title | escape }}</li>
      {%- endcase -%}
    </ol>
  </nav>
</div>

{% schema %}
{
  "name": "Breadcrumbs",
  "tag": "section",
  "class": "section zx-breadcrumbs-section",
  "enabled_on": {
    "templates": ["product", "collection", "search", "page", "blog", "article", "list-collections"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Breadcrumbs"
    }
  ]
}
{% endschema %}
