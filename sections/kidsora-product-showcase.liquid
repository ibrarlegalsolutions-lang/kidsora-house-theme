{% liquid
  assign selected_collection = section.settings.collection
  assign product_limit = section.settings.product_limit
%}
<section class="ks-products ks-products--{{ section.id }}" style="--ks-bg:{{ section.settings.background }};--ks-cols:{{ section.settings.columns }};--ks-gap:{{ section.settings.gap }}px">
  <div class="ks-products__inner">
    <header class="ks-products__header">
      <div>{% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.subtitle != blank %}<div class="rte">{{ section.settings.subtitle }}</div>{% endif %}</div>
      {% if selected_collection != blank %}<a href="{{ selected_collection.url }}">{{ section.settings.view_all | escape }}</a>{% endif %}
    </header>
    <div class="ks-products__grid">
      {% if selected_collection != blank and selected_collection.products_count > 0 %}
        {% for product in selected_collection.products limit: product_limit %}
          <article class="ks-product">
            <a href="{{ product.url }}" class="ks-product__media" aria-label="{{ product.title | escape }}">
              {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 25vw, 46vw', loading: 'lazy' }}{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}
              {% if product.compare_at_price > product.price %}<span class="ks-product__badge ks-product__badge--sale">{{ section.settings.sale_label | escape }}</span>{% elsif product.available == false %}<span class="ks-product__badge">{{ section.settings.sold_out_label | escape }}</span>{% endif %}
            </a>
            <div class="ks-product__info">
              {% if section.settings.show_vendor and product.vendor != blank %}<p>{{ product.vendor | escape }}</p>{% endif %}
              <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              {% if section.settings.show_rating %}<div class="ks-product__rating" aria-hidden="true">★★★★★</div>{% endif %}
              <div class="ks-product__price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</div>
            </div>
          </article>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <article class="ks-product ks-product--placeholder"><div class="ks-product__media">{{ 'product-apparel-' | append: i | placeholder_svg_tag }}</div><div class="ks-product__info"><h3>Product placeholder {{ i }}</h3><p>Select a real collection in the theme editor</p></div></article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
{% stylesheet %}
  .ks-products{background:var(--ks-bg);padding:clamp(44px,7vw,88px) 20px}.ks-products__inner{max-width:1280px;margin:auto}.ks-products__header{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:28px}.ks-products__header p{margin:0 0 6px;color:#D9A1A5;font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}.ks-products__header h2{margin:0;font-family:var(--font-heading--family);font-size:clamp(2rem,4vw,3.2rem)}.ks-products__header a{color:inherit;text-underline-offset:5px}.ks-products__grid{display:grid;grid-template-columns:repeat(var(--ks-cols),minmax(0,1fr));gap:var(--ks-gap)}.ks-product__media{position:relative;display:block;overflow:hidden;background:#E5DCC9;aspect-ratio:4/5;border-radius:10px}.ks-product__media img,.ks-product__media svg{width:100%;height:100%;object-fit:cover;transition:transform .45s ease}.ks-product:hover img{transform:scale(1.025)}.ks-product__badge{position:absolute;left:10px;top:10px;padding:5px 11px;border-radius:999px;background:#fff;color:#3D3A36;font-size:.7rem;font-weight:600;letter-spacing:.03em}.ks-product__badge--sale{background:#D9A1A5;color:#fff}.ks-product__info{padding-top:12px}.ks-product__info p{margin:0 0 4px;font-size:.75rem;color:#6B6259}.ks-product__info h3{font-size:.95rem;margin:0 0 6px;line-height:1.35;font-weight:500}.ks-product__info a{color:inherit;text-decoration:none}.ks-product__price{font-size:.92rem}.ks-product__price s{color:#6B6259;margin-left:5px}.ks-product__rating{color:#D9A1A5;font-size:.72rem;letter-spacing:1px;margin-bottom:5px}.ks-product--placeholder{opacity:.8}
  @media(max-width:749px){.ks-products{padding-inline:16px}.ks-products__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.ks-products__header{align-items:start}.ks-products__header a{white-space:nowrap}}
  @media(prefers-reduced-motion:reduce){.ks-product__media img{transition:none}}
{% endstylesheet %}
{% schema %}
{"name":"Kidsora product showcase","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FRESHLY ADDED"},{"type":"text","id":"heading","label":"Heading","default":"New arrivals"},{"type":"richtext","id":"subtitle","label":"Subtitle"},{"type":"text","id":"view_all","label":"View-all label","default":"View all"},{"type":"text","id":"sold_out_label","label":"Sold-out label","default":"Sold out"},{"type":"text","id":"sale_label","label":"Sale label","default":"Sale"},{"type":"checkbox","id":"show_rating","label":"Show star rating","default":true},{"type":"range","id":"product_limit","label":"Products","min":4,"max":16,"step":1,"default":8},{"type":"range","id":"columns","label":"Desktop columns","min":2,"max":6,"step":1,"default":4},{"type":"range","id":"gap","label":"Grid gap","min":8,"max":40,"step":4,"unit":"px","default":20},{"type":"checkbox","id":"show_vendor","label":"Show vendor","default":false},{"type":"color","id":"background","label":"Background","default":"#ffffff"}],"presets":[{"name":"Kidsora product showcase"}],"disabled_on":{"groups":["header","footer"]}}
{% endschema %}
