{%- liquid
  assign desktop = section.settings.image
  assign mobile = section.settings.image_mobile | default: desktop
  assign alt = section.settings.alt | default: desktop.alt | escape
  assign is_first = false
  if section.index == 1
    assign is_first = true
  endif
  assign loading = 'lazy'
  assign priority = 'auto'
  if is_first
    assign loading = 'eager'
    assign priority = 'high'
  endif
  assign tag = 'div'
  if section.settings.link != blank
    assign tag = 'a'
  endif
-%}

<{{ tag }}
  class="zx-banner{% if section.settings.width == 'page-width' %} zx-banner--boxed{% endif %}"
  {% if tag == 'a' %}href="{{ section.settings.link }}"{% endif %}
>
  {%- if desktop != blank -%}
    <picture>
      {%- if section.settings.image_mobile != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ mobile | image_url: width: 750 }} 750w, {{ mobile | image_url: width: 1100 }} 1100w, {{ mobile | image_url: width: 1500 }} 1500w"
          sizes="100vw"
          width="{{ mobile.width }}"
          height="{{ mobile.height }}"
        >
      {%- endif -%}
      {{
        desktop
        | image_url: width: 3000
        | image_tag:
          widths: '750, 1100, 1500, 1920, 2400, 3000',
          sizes: '100vw',
          loading: loading,
          fetchpriority: priority,
          alt: alt,
          class: 'zx-banner__img'
      }}
    </picture>
  {%- else -%}
    <div class="zx-banner__placeholder">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'zx-banner__img' }}
    </div>
  {%- endif -%}
</{{ tag }}>

{% stylesheet %}
  .zx-banner {
    display: block;
    width: 100%;
    line-height: 0;
  }

  .zx-banner--boxed {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .zx-banner picture,
  .zx-banner__img {
    display: block;
    width: 100%;
    height: auto;
  }

  .zx-banner__placeholder {
    aspect-ratio: 16 / 7;
    background: #f3f3f3;
  }

  .zx-banner__placeholder .zx-banner__img {
    height: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "class": "zx-banner-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shown at its natural shape, never cropped"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Image description (alt text)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "full-width", "label": "Full width" },
        { "value": "page-width", "label": "Page width" }
      ],
      "default": "full-width"
    }
  ],
  "presets": [
    {
      "name": "Image banner"
    }
  ]
}
{% endschema %}
