<section class="ks-newsletter ks-newsletter--{{ section.id }}" style="--ks-bg:{{ section.settings.background }};--ks-fg:{{ section.settings.text_color }};--ks-accent:{{ section.settings.accent_color }}">
  <div class="ks-newsletter__inner"><div><p>{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}</div>
    {% form 'customer', class: 'ks-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {% if form.posted_successfully? %}<p role="status">{{ section.settings.success | escape }}</p>{% else %}
        {{ form.errors | default_errors }}
        <label for="KsEmail-{{ section.id }}">{{ section.settings.label | escape }}</label><div><input id="KsEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ section.settings.placeholder | escape }}"><button type="submit">{{ section.settings.button | escape }}</button></div>
        {% if section.settings.consent != blank %}<small>{{ section.settings.consent | escape }}</small>{% endif %}
      {% endif %}
    {% endform %}
  </div>
</section>
{% stylesheet %}
  .ks-newsletter{background:var(--ks-bg);color:var(--ks-fg);padding:clamp(48px,8vw,96px) 20px}.ks-newsletter__inner{max-width:1120px;margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,8vw,100px);align-items:center}.ks-newsletter p{margin:0 0 8px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;font-size:.75rem;color:var(--ks-accent)}.ks-newsletter h2{margin:0;font-family:var(--font-heading--family);font-size:clamp(1.9rem,4vw,3rem)}.ks-newsletter__form label{display:block;margin-bottom:8px;font-weight:500}.ks-newsletter__form>div{display:flex}.ks-newsletter input{width:100%;min-height:52px;border:1px solid rgba(255,255,255,.35);border-radius:100px 0 0 100px;padding:0 20px;background:rgba(255,255,255,.08);color:var(--ks-fg)}.ks-newsletter input::placeholder{color:currentColor;opacity:.6}.ks-newsletter button{min-height:52px;border:0;border-radius:0 100px 100px 0;padding:0 28px;background:var(--ks-accent);color:#fff;font-weight:600}.ks-newsletter small{display:block;margin-top:10px;opacity:.65;font-size:.78rem}
  @media(max-width:749px){.ks-newsletter__inner{grid-template-columns:1fr}.ks-newsletter__form>div{display:block}.ks-newsletter input,.ks-newsletter button{width:100%;border-radius:100px}.ks-newsletter button{margin-top:10px}}
{% endstylesheet %}
{% schema %}
{"name":"Kidsora newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"JOIN THE FAMILY"},{"type":"text","id":"heading","label":"Heading","default":"Join the Kidsora House family"},{"type":"richtext","id":"text","label":"Text","default":"<p>New arrivals, restocks and offers — straight to your inbox.</p>"},{"type":"text","id":"label","label":"Email label","default":"Email address"},{"type":"text","id":"placeholder","label":"Placeholder","default":"Enter your email"},{"type":"text","id":"button","label":"Button","default":"Subscribe"},{"type":"text","id":"success","label":"Success message","default":"Thank you for subscribing."},{"type":"text","id":"consent","label":"Consent wording","default":"By subscribing you agree to receive marketing emails from Kidsora House."},{"type":"color","id":"background","label":"Background","default":"#5B7075"},{"type":"color","id":"text_color","label":"Text","default":"#F8F3EA"},{"type":"color","id":"accent_color","label":"Accent","default":"#D9A1A5"}],"presets":[{"name":"Kidsora newsletter"}],"disabled_on":{"groups":["header","footer"]}}
{% endschema %}
