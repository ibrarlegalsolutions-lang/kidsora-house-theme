<div class="zx-size-grid section section--page-width">
  <div class="zx-size-grid__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="zx-size-grid__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ul class="zx-size-grid__list" style="--zx-size-cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign url = block.settings.link
          if url == blank
            assign query = block.settings.label | url_encode
            assign url = routes.search_url | append: '?type=product&q=' | append: query
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <a class="zx-size-grid__tile" href="{{ url }}">{{ block.settings.label }}</a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .zx-size-grid {
    padding-block: 32px 48px;
  }

  .zx-size-grid__inner {
    max-width: 1100px;
    width: 100%;
    margin-inline: auto;
  }

  .zx-size-grid__heading {
    margin: 0 0 28px;
    text-align: center;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 30px;
    line-height: 1.2;
    color: #111;
  }

  .zx-size-grid__list {
    display: grid;
    grid-template-columns: repeat(var(--zx-size-cols), minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zx-size-grid__tile {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 72px;
    padding: 12px;
    border-radius: 14px;
    background: #f3f6f9;
    box-shadow: 0 2px 6px rgb(15 35 60 / 0.06);
    color: #111;
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 18px;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .zx-size-grid__tile:hover {
    background: #111;
    color: #fff;
  }

  @media screen and (max-width: 749px) {
    .zx-size-grid__heading {
      font-size: 24px;
      margin-bottom: 18px;
    }

    .zx-size-grid__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .zx-size-grid__tile {
      min-height: 56px;
      font-size: 15px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by size",
  "tag": "section",
  "class": "zx-size-grid-section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By Size"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Size",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "1–2 Years"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave empty to search products for this size"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by size",
      "blocks": [
        { "type": "size", "settings": { "label": "0–3M" } },
        { "type": "size", "settings": { "label": "3–6M" } },
        { "type": "size", "settings": { "label": "6–9M" } },
        { "type": "size", "settings": { "label": "9–12M" } }
      ]
    }
  ]
}
{% endschema %}
