<section class="kp-categories kp-categories--{{ section.id }}" style="--kp-bg:{{ section.settings.background }};--kp-cols:{{ section.settings.columns }};--kp-radius:{{ section.settings.radius }}px;--kp-gap:{{ section.settings.gap }}px">
  <div class="kp-categories__inner">
    <header class="kp-section-heading"><div>{% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}</header>
    <div class="kp-categories__grid">
      {% for block in section.blocks %}
        {% liquid
          assign chosen_collection = block.settings.collection
          assign card_image = block.settings.image | default: chosen_collection.featured_image
          assign card_title = block.settings.title | default: chosen_collection.title
          assign card_url = block.settings.link | default: chosen_collection.url | default: routes.all_products_collection_url
        %}
        <a class="kp-category" href="{{ card_url }}" {{ block.shopify_attributes }}>
          <div class="kp-category__media">{% if card_image != blank %}{{ card_image | image_url: width: 900 | image_tag: widths: '300, 500, 700, 900', sizes: '(min-width: 990px) 25vw, 70vw', loading: 'lazy' }}{% else %}{{ 'collection-apparel-1' | placeholder_svg_tag }}{% endif %}</div>
          <div class="kp-category__content"><h3>{{ card_title | escape }}</h3>{% if block.settings.subtitle != blank %}<p>{{ block.settings.subtitle | escape }}</p>{% endif %}<span>{{ block.settings.button_label | escape }}</span></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% stylesheet %}
  .kp-categories{background:var(--kp-bg);padding:clamp(42px,7vw,88px) 20px}.kp-categories__inner{max-width:1280px;margin:auto}.kp-section-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:28px}.kp-section-heading h2{margin:4px 0 0;font-size:clamp(2rem,4vw,3.4rem)}.kp-section-heading p{margin:0;color:#D9A1A5;font-weight:600;letter-spacing:.12em;text-transform:uppercase;font-size:.78rem}.kp-section-heading .rte{max-width:46ch}.kp-categories__grid{display:grid;grid-template-columns:repeat(var(--kp-cols),1fr);gap:var(--kp-gap)}.kp-category{position:relative;display:grid;min-height:380px;overflow:hidden;border-radius:var(--kp-radius);color:#fff;text-decoration:none;background:#E5DCC9}.kp-category__media,.kp-category__content{grid-area:1/1}.kp-category__media img,.kp-category__media svg{width:100%;height:100%;object-fit:cover;transition:transform .5s ease}.kp-category__content{z-index:1;align-self:end;padding:24px;background:linear-gradient(transparent,rgba(61,58,54,.82))}.kp-category h3{margin:0;font-family:var(--font-heading--family);font-size:1.4rem;font-weight:600}.kp-category p{margin:6px 0;font-size:.85rem;opacity:.9}.kp-category span{display:inline-block;margin-top:12px;border-bottom:1px solid;font-size:.85rem}.kp-category:hover img{transform:scale(1.035)}
  @media(max-width:749px){.kp-section-heading{display:block}.kp-categories__grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:8px}.kp-category{min-width:68vw;min-height:340px;scroll-snap-align:start}}
  @media(prefers-reduced-motion:reduce){.kp-category__media img{transition:none}}
{% endstylesheet %}
{% schema %}
{"name":"Kidsora category cards","max_blocks":8,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"EXPLORE"},{"type":"text","id":"heading","label":"Heading","default":"Shop by category"},{"type":"richtext","id":"text","label":"Description"},{"type":"range","id":"columns","label":"Desktop columns","min":2,"max":6,"step":1,"default":3},{"type":"range","id":"gap","label":"Grid gap","min":8,"max":40,"step":4,"unit":"px","default":20},{"type":"range","id":"radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":16},{"type":"color","id":"background","label":"Background","default":"#ffffff"}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Override image"},{"type":"text","id":"title","label":"Override title"},{"type":"text","id":"subtitle","label":"Subtitle"},{"type":"text","id":"button_label","label":"Link label","default":"Shop now"},{"type":"url","id":"link","label":"Override link"}]}],"presets":[{"name":"Kidsora category cards","blocks":[{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}],"disabled_on":{"groups":["header","footer"]}}
{% endschema %}
