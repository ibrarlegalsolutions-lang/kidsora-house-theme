<section class="kp-reviews kp-reviews--{{ section.id }}" style="--kp-bg:{{ section.settings.background }};--kp-fg:{{ section.settings.text_color }};--kp-accent:{{ section.settings.accent_color }}">
  <div class="kp-reviews__inner">
    <header class="kp-reviews__header">
      {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
    </header>
    <div class="kp-reviews__grid">
      {% for block in section.blocks %}
        <article class="kp-review" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="kp-review__media">{{ block.settings.image | image_url: width: 300 | image_tag: widths: '150, 200, 300', sizes: '80px', loading: 'lazy' }}</div>
          {% endif %}
          <div class="kp-review__stars" aria-hidden="true">
            {% for i in (1..5) %}
              {% if i <= block.settings.rating %}★{% else %}☆{% endif %}
            {% endfor %}
          </div>
          {% if block.settings.text != blank %}<p class="kp-review__text">&ldquo;{{ block.settings.text | escape }}&rdquo;</p>{% endif %}
          <p class="kp-review__name">{{ block.settings.name | escape }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% stylesheet %}
  .kp-reviews{background:var(--kp-bg);color:var(--kp-fg);padding:clamp(48px,7vw,88px) 20px}
  .kp-reviews__inner{max-width:1120px;margin:auto}
  .kp-reviews__header{text-align:center;margin-bottom:clamp(32px,5vw,52px)}
  .kp-reviews__header p{margin:0 0 8px;color:var(--kp-accent);font-weight:600;letter-spacing:.14em;text-transform:uppercase;font-size:.72rem}
  .kp-reviews__header h2{margin:0;font-size:clamp(1.9rem,3.6vw,2.9rem)}
  .kp-reviews__header .rte{margin-top:10px;opacity:.75}
  .kp-reviews__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
  .kp-review{background:rgba(255,255,255,.5);border:1px solid rgba(0,0,0,.08);border-radius:16px;padding:28px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px}
  .kp-review__media{width:56px;height:56px;border-radius:50%;overflow:hidden}
  .kp-review__media img{width:100%;height:100%;object-fit:cover}
  .kp-review__stars{color:var(--kp-accent);letter-spacing:2px;font-size:1rem}
  .kp-review__text{margin:6px 0 0;font-size:.95rem;line-height:1.6;max-width:38ch}
  .kp-review__name{margin:4px 0 0;font-size:.8rem;opacity:.65;text-transform:uppercase;letter-spacing:.06em}
  @media(max-width:749px){.kp-reviews__grid{grid-template-columns:1fr;gap:18px}}
{% endstylesheet %}
{% schema %}
{"name":"Kidsora reviews","max_blocks":6,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"TESTIMONIALS"},{"type":"text","id":"heading","label":"Heading","default":"Let customers speak for us"},{"type":"richtext","id":"text","label":"Text"},{"type":"color","id":"background","label":"Background","default":"#F8F3EA"},{"type":"color","id":"text_color","label":"Text","default":"#3D3A36"},{"type":"color","id":"accent_color","label":"Stars / eyebrow color","default":"#D9A1A5"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"image_picker","id":"image","label":"Product or customer photo"},{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"text","id":"text","label":"Review text","default":"Amazing quality and such soft fabric, my little one loves it."},{"type":"text","id":"name","label":"Customer name","default":"Happy parent"}]}],"presets":[{"name":"Kidsora reviews","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}],"disabled_on":{"groups":["header","footer"]}}
{% endschema %}
