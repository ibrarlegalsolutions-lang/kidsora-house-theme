<script
  src="{{ 'zx-scroller.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
  assign zx_collection = section.settings.collection
  assign limit = section.settings.products_to_show
  assign visible = section.settings.visible_cards
  assign card_sizes = '(min-width: 990px) calc(70vw / ' | append: visible | append: '), 45vw'
-%}

<div
  class="zx-split zx-split--image-{{ section.settings.image_position }}"
  style="
    --zx-image-width: {{ section.settings.image_width }}%;
    --zx-visible: {{ visible }};
    padding-block: {{ section.settings.padding-block-start }}px {{ section.settings.padding-block-end }}px;
    {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
  "
>
  <div class="zx-split__media">
    {%- if section.settings.image_link != blank -%}
      <a class="zx-split__media-link" href="{{ section.settings.image_link }}">
    {%- else -%}
      <div class="zx-split__media-link">
    {%- endif -%}
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1400
        | image_tag:
          class: 'zx-split__image',
          widths: '375, 550, 750, 1000, 1400',
          sizes: '(min-width: 990px) 30vw, 100vw',
          loading: 'lazy',
          alt: section.settings.image.alt | default: section.settings.heading
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'zx-split__image zx-split__image--placeholder' }}
    {%- endif -%}
    {%- if section.settings.image_link != blank -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}
  </div>

  <div class="zx-split__content">
    <zx-scroller class="zx-split__scroller">
      <ul class="zx-split__track zx-scroller list-unstyled" data-zx-track role="list">
        {%- if zx_collection != blank and zx_collection.products_count > 0 -%}
          {%- for product in zx_collection.products limit: limit -%}
            <li class="zx-split__slide">
              {% render 'zx-product-card',
                product: product,
                sizes: card_sizes,
                show_sizes: section.settings.show_sizes,
                size_option: section.settings.size_option
              %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..visible) -%}
            <li class="zx-split__slide">
              {% render 'zx-product-card', product: blank %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      <div class="zx-split__controls">
        <button type="button" class="zx-split__arrow button-unstyled" data-zx-prev aria-label="{{ 'accessibility.slideshow_previous' | t }}">
          <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <button type="button" class="zx-split__arrow button-unstyled" data-zx-next aria-label="{{ 'accessibility.slideshow_next' | t }}">
          <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </zx-scroller>

    {%- if section.settings.heading != blank or section.settings.button_label != blank -%}
      <div class="zx-split__footer">
        {%- if section.settings.heading != blank -%}
          <h2 class="zx-split__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          {%- liquid
            assign button_url = section.settings.button_link
            if button_url == blank and zx_collection != blank
              assign button_url = zx_collection.url
            endif
          -%}
          <a class="zx-split__button button-secondary" href="{{ button_url | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .zx-split {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 990px) {
    .zx-split {
      grid-template-columns: var(--zx-image-width) minmax(0, 1fr);
      align-items: stretch;
    }

    .zx-split--image-right .zx-split__media {
      order: 2;
    }
  }

  .zx-split__media-link {
    position: relative;
    display: block;
    height: 100%;
    min-height: 420px;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--zx-card-media-bg, #f2f2f2);
  }

  @media screen and (min-width: 990px) {
    .zx-split__media-link {
      aspect-ratio: auto;
    }
  }

  .zx-split__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .zx-split__image--placeholder {
    fill: rgb(0 0 0 / 0.25);
  }

  .zx-split__content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }

  .zx-split__scroller {
    position: relative;
    display: block;
  }

  .zx-split__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 44%;
    gap: 0;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .zx-split__track::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .zx-split__track {
      grid-auto-columns: calc(100% / 3);
    }
  }

  @media screen and (min-width: 990px) {
    .zx-split__track {
      grid-auto-columns: calc(100% / var(--zx-visible));
    }
  }

  .zx-split__slide {
    scroll-snap-align: start;
    padding-block-end: 8px;
  }

  .zx-split__slide .zx-card > :not(.zx-card__media) {
    padding-inline: 8px;
  }

  .zx-split__controls {
    position: absolute;
    inset-inline: 0;
    top: 38%;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .zx-split__arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    color: #111;
    background: rgb(255 255 255 / 0.85);
    pointer-events: auto;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .zx-split__arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }

  zx-scroller:not([data-overflowing]) .zx-split__controls {
    display: none;
  }

  .zx-split__footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 24px var(--page-margin, 16px) 24px;
  }

  @media screen and (min-width: 990px) {
    .zx-split__footer {
      padding: 32px 16px 16px;
    }
  }

  .zx-split__heading {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .zx-split__button {
    padding: 10px 24px;
    font-size: 11px;
    letter-spacing: 0.08em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:zx_names.featured_split",
  "tag": "section",
  "class": "zx-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:zx_settings.image"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "t:zx_settings.image_link"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:zx_settings.image_position",
      "options": [
        { "value": "left", "label": "t:zx_options.left" },
        { "value": "right", "label": "t:zx_options.right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "t:zx_settings.image_width",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "t:zx_settings.products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:zx_settings.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:zx_settings.products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "visible_cards",
      "label": "t:zx_settings.visible_cards",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_sizes",
      "label": "t:zx_settings.show_sizes",
      "default": true
    },
    {
      "type": "text",
      "id": "size_option",
      "label": "t:zx_settings.size_option",
      "default": "Size"
    },
    {
      "type": "header",
      "content": "t:zx_settings.text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:zx_settings.heading",
      "default": "Categories in focus"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:zx_settings.button_label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:zx_settings.button_link",
      "info": "t:zx_info.button_link_collection"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:zx_settings.background_color"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:zx_settings.top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:zx_settings.bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:zx_names.featured_split",
      "category": "t:zx_names.category"
    }
  ]
}
{% endschema %}
