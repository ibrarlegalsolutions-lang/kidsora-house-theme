<div
  class="zx-readmore"
  style="
    padding-block: {{ section.settings.padding-block-start }}px {{ section.settings.padding-block-end }}px;
    {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
  "
>
  <div class="zx-readmore__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="zx-readmore__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="zx-readmore__text rte">{{ section.settings.intro }}</div>
    {%- endif -%}
    {%- if section.settings.more != blank -%}
      <details class="zx-readmore__details">
        <summary class="zx-readmore__toggle">
          <span class="zx-readmore__open">{{ 'content.read_more' | t }}</span>
          <span class="zx-readmore__close">{{ 'content.zx_read_less' | t }}</span>
        </summary>
        <div class="zx-readmore__text rte">{{ section.settings.more }}</div>
      </details>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .zx-readmore__inner {
    width: min(100% - 2 * var(--page-margin, 16px), var(--page-content-width, 1400px));
    margin: 0 auto;
    font-size: 12px;
    line-height: 1.7;
  }

  .zx-readmore__heading {
    margin: 0 0 12px;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .zx-readmore__text p {
    margin: 0 0 10px;
  }

  .zx-readmore__details {
    display: flex;
    flex-direction: column-reverse;
  }

  .zx-readmore__toggle {
    display: inline-block;
    width: fit-content;
    margin-top: 4px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .zx-readmore__toggle::-webkit-details-marker {
    display: none;
  }

  .zx-readmore__toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .zx-readmore__close,
  .zx-readmore__details[open] .zx-readmore__open {
    display: none;
  }

  .zx-readmore__details[open] .zx-readmore__close {
    display: inline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:zx_names.read_more_text",
  "tag": "section",
  "class": "zx-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:zx_settings.heading",
      "default": "Kids' clothing made for everyday adventures"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:zx_settings.intro_text",
      "default": "<p>Use this area to introduce your store: what you make, who it is for and why parents choose you. Search engines read this text, so describe your collections in plain words.</p>"
    },
    {
      "type": "richtext",
      "id": "more",
      "label": "t:zx_settings.more_text",
      "info": "t:zx_info.more_text",
      "default": "<p>Add a longer story here: fabrics, sizing, care, delivery and returns. Visitors reveal it with the Read more link.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:zx_settings.background_color"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:zx_settings.top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:zx_settings.bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "t:zx_names.read_more_text",
      "category": "t:zx_names.category"
    }
  ]
}
{% endschema %}
