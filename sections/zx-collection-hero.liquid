<section class="zx-section zx-colhero">
  <div class="zx-wrap">
    <h1 class="zx-colhero__title">{{ section.settings.heading | default: collection.title | default: 'Collection' | escape }}</h1>
    {%- assign intro = section.settings.text | default: collection.description -%}
    {%- if intro != blank -%}<div class="zx-colhero__text">{{ intro | strip_html | truncate: 220 }}</div>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="zx-colhero__subs" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign c = block.settings.collection
            assign img = block.settings.image | default: c.featured_image
            assign label = block.settings.label | default: c.title
            assign url = block.settings.link | default: c.url
          -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ url | default: '#' }}" class="zx-colhero__sub{% if c and c.handle == collection.handle %} is-active{% endif %}">
              <span class="zx-colhero__thumb">
                {%- if img != blank -%}
                  {{ img | image_url: width: 240 | image_tag: loading: 'lazy', width: 120, height: 120, alt: '' }}
                {%- else -%}
                  {{ 'collection-' | append: forloop.index | placeholder_svg_tag }}
                {%- endif -%}
              </span>
              <span class="zx-colhero__label">{{ label | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .zx-colhero { padding: 32px 0 24px; text-align: center; }
  .zx-colhero__title { margin: 0; font-family: var(--zx-font-display); font-weight: 400; font-size: 32px; line-height: 36px; color: var(--zx-ink); }
  .zx-colhero__text { max-width: 720px; margin: 8px auto 0; font-size: 14px; line-height: 20px; }
  .zx-colhero__subs { list-style: none; margin: 24px auto 0; padding: 0; display: flex; justify-content: center; gap: 16px; overflow-x: auto; scrollbar-width: none; }
  .zx-colhero__sub { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 96px; color: var(--zx-ink); text-decoration: none; font-size: 12px; line-height: 14px; }
  .zx-colhero__thumb { width: 96px; height: 96px; overflow: hidden; background: var(--zx-tile); display: block; }
  .zx-colhero__thumb img, .zx-colhero__thumb svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .zx-colhero__sub.is-active .zx-colhero__label, .zx-colhero__sub:hover .zx-colhero__label { text-decoration: underline; }
  @media (max-width: 749px) {
    .zx-colhero__title { font-size: 26px; line-height: 30px; }
    .zx-colhero__subs { justify-content: flex-start; padding-inline: 0; }
    .zx-colhero__sub { width: 76px; flex-shrink: 0; }
    .zx-colhero__thumb { width: 76px; height: 76px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ZX Collection header",
  "class": "zx-colhero-section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the collection title" },
    { "type": "textarea", "id": "text", "label": "Intro", "info": "Defaults to the collection description" }
  ],
  "blocks": [
    {
      "type": "sub",
      "name": "Sub-category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Square, 240 × 240 px minimum" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "ZX Collection header" }]
}
{% endschema %}
