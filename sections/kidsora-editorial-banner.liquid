<section class="kp-editorial kp-editorial--{{ section.id }} kp-editorial--{{ section.settings.layout }}" style="--kp-bg:{{ section.settings.background }};--kp-fg:{{ section.settings.text_color }};--kp-ratio:{{ section.settings.image_ratio }}">
  <div class="kp-editorial__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '(min-width: 750px) 58vw, 100vw', loading: 'lazy' }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag }}{% endif %}</div>
  <div class="kp-editorial__content">{% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}{% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div>
</section>
{% stylesheet %}
  .kp-editorial{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(320px,.65fr);background:var(--kp-bg);color:var(--kp-fg);min-height:560px}.kp-editorial--image-right{grid-template-columns:minmax(320px,.65fr) minmax(0,1.35fr)}.kp-editorial--image-right .kp-editorial__media{order:2}.kp-editorial__media{min-height:100%;overflow:hidden}.kp-editorial__media img,.kp-editorial__media svg{display:block;width:100%;height:100%;object-fit:cover;aspect-ratio:var(--kp-ratio)}.kp-editorial__content{display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:clamp(36px,7vw,100px)}.kp-editorial__content>p{margin:0 0 10px;color:#D9A1A5;font-weight:600;letter-spacing:.12em;text-transform:uppercase;font-size:.78rem}.kp-editorial h2{font-family:var(--font-heading--family);font-size:clamp(2rem,4vw,3.6rem);line-height:1.08;margin:0;max-width:13ch}.kp-editorial .rte{margin:18px 0 24px;max-width:52ch}.kp-editorial .button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding-inline:32px;border-radius:100px;background:var(--kp-fg);color:var(--kp-bg);text-decoration:none;font-weight:600}
  @media(max-width:749px){.kp-editorial,.kp-editorial--image-right{grid-template-columns:1fr}.kp-editorial--image-right .kp-editorial__media{order:0}.kp-editorial__content{padding:38px 20px}.kp-editorial__media{min-height:420px}}
{% endstylesheet %}
{% schema %}
{"name":"Kidsora editorial banner","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"KIDSORA HOUSE"},{"type":"text","id":"heading","label":"Heading","default":"Made for real days"},{"type":"richtext","id":"text","label":"Text","default":"<p>Soft cotton essentials designed for everyday comfort.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Shop Essentials"},{"type":"url","id":"button_link","label":"Button link"},{"type":"select","id":"layout","label":"Desktop layout","options":[{"value":"image-left","label":"Image left"},{"value":"image-right","label":"Image right"}],"default":"image-left"},{"type":"select","id":"image_ratio","label":"Image ratio","options":[{"value":"4/3","label":"Landscape"},{"value":"1/1","label":"Square"},{"value":"4/5","label":"Portrait"}],"default":"4/3"},{"type":"color","id":"background","label":"Background","default":"#F8F3EA"},{"type":"color","id":"text_color","label":"Text","default":"#3D3A36"}],"presets":[{"name":"Kidsora editorial banner"}],"disabled_on":{"groups":["header","footer"]}}
{% endschema %}
