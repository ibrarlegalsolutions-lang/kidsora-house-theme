<section class="zx-section zx-promo" style="--zx-promo-h: {{ section.settings.height }}px; --zx-promo-text: {{ section.settings.text_color }}; --zx-promo-bg: {{ section.settings.background }};">
  <div class="zx-promo__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1440, 1920, 2400', alt: section.settings.image.alt | escape }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="zx-promo__content">
    {%- if section.settings.eyebrow != blank -%}<p class="zx-promo__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="zx-promo__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="zx-promo__text">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.link_label != blank -%}<a class="zx-promo__link" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
  </div>
</section>

{% stylesheet %}
  .zx-promo { position: relative; height: var(--zx-promo-h); overflow: hidden; background: var(--zx-promo-bg); color: var(--zx-promo-text); }
  .zx-promo__media, .zx-promo__media img, .zx-promo__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .zx-promo__content { position: absolute; left: 5%; top: 50%; transform: translateY(-50%); max-width: 46%; display: flex; flex-direction: column; gap: 12px; }
  .zx-promo__eyebrow { margin: 0; font-family: var(--zx-font-condensed); font-size: 32px; line-height: 1.1; text-transform: uppercase; letter-spacing: var(--zx-tracking); }
  .zx-promo__heading { margin: 0; font-family: var(--zx-font-condensed); font-weight: 400; font-size: clamp(28px, 3.4vw, 50px); line-height: 1.05; text-transform: uppercase; letter-spacing: var(--zx-tracking); }
  .zx-promo__text { font-size: 18px; line-height: 1.3; }
  .zx-promo__text p { margin: 0; }
  .zx-promo__link { color: inherit; font-size: 16px; text-decoration: underline; text-underline-offset: 3px; margin-top: 8px; font-weight: 700; }
  @media (max-width: 749px) {
    .zx-promo { height: auto; display: flex; flex-direction: column; }
    .zx-promo__media { position: relative; aspect-ratio: 4 / 3; }
    .zx-promo__content { position: static; transform: none; max-width: none; padding: 24px 16px 32px; }
    .zx-promo__eyebrow { font-size: 22px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ZX Promo banner",
  "class": "zx-promo-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "2880 × 820 px recommended; keep the left 45% clear for text" },
    { "type": "range", "id": "height", "label": "Desktop height", "min": 300, "max": 800, "step": 10, "unit": "px", "default": 410 },
    { "type": "color", "id": "background", "label": "Background", "default": "#e8b7b5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "It's back!" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The beauty soulmates face palette" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>In two new shades</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop Now" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "ZX Promo banner" }]
}
{% endschema %}
