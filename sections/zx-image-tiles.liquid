{%- liquid
  assign placeholders = 'collection-apparel-1,collection-apparel-2,collection-apparel-3,collection-apparel-4,lifestyle-1,lifestyle-2' | split: ','
  assign tile_count = section.blocks.size
-%}

<div
  class="zx-image-tiles zx-image-tiles--{{ section.id }} section--{{ section.settings.section_width }}"
  style="
    --zx-columns: {{ section.settings.columns }};
    --zx-columns-mobile: {{ section.settings.mobile_columns }};
    --zx-gap: {{ section.settings.gap }}px;
    --zx-ratio: {{ section.settings.aspect_ratio }};
    --zx-label-color: {{ section.settings.text_color }};
    --zx-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --zx-label-size: {{ section.settings.label_size }}px;
    padding-block: {{ section.settings.padding-block-start }}px {{ section.settings.padding-block-end }}px;
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="zx-image-tiles__heading h4">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <ul class="zx-image-tiles__grid list-unstyled" role="list">
    {%- for block in section.blocks -%}
      <li class="zx-image-tiles__tile zx-image-tiles__tile--{{ section.settings.label_position }}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a class="zx-image-tiles__link" href="{{ block.settings.link }}">
        {%- else -%}
          <div class="zx-image-tiles__link">
        {%- endif -%}
        {%- if block.settings.image != blank -%}
          {%- liquid
            assign sizes = '(min-width: 750px) calc(100vw / ' | append: section.settings.columns | append: '), calc(100vw / ' | append: section.settings.mobile_columns | append: ')'
            if section.index <= 2 and forloop.index <= section.settings.columns
              assign loading = 'eager'
            else
              assign loading = 'lazy'
            endif
          -%}
          {{
            block.settings.image
            | image_url: width: 1600
            | image_tag:
              class: 'zx-image-tiles__image',
              widths: '375, 550, 750, 1000, 1200, 1600',
              sizes: sizes,
              loading: loading,
              alt: block.settings.image.alt | default: block.settings.label
          }}
        {%- else -%}
          {%- assign placeholder_index = forloop.index0 | modulo: placeholders.size -%}
          {{ placeholders[placeholder_index] | placeholder_svg_tag: 'zx-image-tiles__image zx-image-tiles__image--placeholder' }}
        {%- endif -%}
        {%- if block.settings.label != blank -%}
          <span class="zx-image-tiles__label">{{ block.settings.label }}</span>
        {%- endif -%}
        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
  {%- if tile_count == 0 and request.design_mode -%}
    <p class="zx-image-tiles__empty">{{ 'content.zx_editor_add_blocks' | t }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .zx-image-tiles__heading {
    text-align: center;
    margin: 0 0 20px;
  }

  .zx-image-tiles__grid {
    display: grid;
    grid-template-columns: repeat(var(--zx-columns-mobile), minmax(0, 1fr));
    gap: var(--zx-gap);
    margin: 0;
    padding: 0;
  }

  .zx-image-tiles.section--page-width .zx-image-tiles__grid {
    width: min(100% - 2 * var(--page-margin, 16px), var(--page-content-width, 1400px));
    margin-inline: auto;
  }

  @media screen and (min-width: 750px) {
    .zx-image-tiles__grid {
      grid-template-columns: repeat(var(--zx-columns), minmax(0, 1fr));
    }
  }

  .zx-image-tiles__tile {
    position: relative;
    overflow: hidden;
    background: var(--zx-card-media-bg, #f2f2f2);
  }

  .zx-image-tiles__link {
    position: relative;
    display: block;
    aspect-ratio: var(--zx-ratio);
    color: var(--zx-label-color);
    text-decoration: none;
  }

  .zx-image-tiles__link::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / var(--zx-overlay)), transparent 45%);
    pointer-events: none;
  }

  .zx-image-tiles__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .zx-image-tiles__image--placeholder {
    fill: rgb(0 0 0 / 0.25);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    a.zx-image-tiles__link:hover .zx-image-tiles__image {
      transform: scale(1.03);
    }
  }

  .zx-image-tiles__label {
    position: absolute;
    z-index: 1;
    inset-inline: 0;
    padding: 0 12px;
    text-align: center;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--zx-label-size);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.25);
  }

  .zx-image-tiles__tile--bottom .zx-image-tiles__label {
    bottom: clamp(12px, 3vw, 28px);
  }

  .zx-image-tiles__tile--center .zx-image-tiles__label {
    top: 50%;
    transform: translateY(-50%);
  }

  .zx-image-tiles__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -6px;
  }

  .zx-image-tiles__empty {
    text-align: center;
    padding: 24px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:zx_names.image_tiles",
  "tag": "section",
  "class": "zx-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:zx_settings.heading"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:zx_settings.columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:zx_settings.columns_mobile",
      "options": [
        { "value": "1", "label": "t:zx_options.one" },
        { "value": "2", "label": "t:zx_options.two" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:zx_settings.aspect_ratio",
      "options": [
        { "value": "2 / 3", "label": "t:zx_options.tall" },
        { "value": "3 / 4", "label": "t:zx_options.portrait" },
        { "value": "4 / 5", "label": "t:zx_options.portrait_short" },
        { "value": "1 / 1", "label": "t:zx_options.square" },
        { "value": "4 / 3", "label": "t:zx_options.landscape" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:zx_settings.gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:zx_settings.width",
      "options": [
        { "value": "full-width", "label": "t:zx_options.full" },
        { "value": "page-width", "label": "t:zx_options.page" }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "t:zx_settings.labels"
    },
    {
      "type": "select",
      "id": "label_position",
      "label": "t:zx_settings.label_position",
      "options": [
        { "value": "bottom", "label": "t:zx_options.bottom" },
        { "value": "center", "label": "t:zx_options.center" }
      ],
      "default": "bottom"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "t:zx_settings.label_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:zx_settings.text_color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:zx_settings.overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:zx_settings.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:zx_settings.top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:zx_settings.bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:zx_names.tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:zx_settings.image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:zx_settings.label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:zx_settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:zx_names.image_tiles",
      "category": "t:zx_names.category",
      "blocks": [
        { "type": "tile", "settings": { "label": "Little girl" } },
        { "type": "tile", "settings": { "label": "Little boy" } },
        { "type": "tile", "settings": { "label": "Girl" } },
        { "type": "tile", "settings": { "label": "Boy" } }
      ]
    },
    {
      "name": "t:zx_names.split_banner",
      "category": "t:zx_names.category",
      "settings": { "columns": 2, "mobile_columns": "1", "aspect_ratio": "4 / 5", "label_position": "center", "label_size": 18 },
      "blocks": [
        { "type": "tile", "settings": { "label": "Tops" } },
        { "type": "tile", "settings": { "label": "Bottoms" } }
      ]
    }
  ]
}
{% endschema %}
