<script
  src="{{ 'zx-scroller.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div
  class="zx-strip{% if section.settings.grayscale %} zx-strip--grayscale{% endif %}"
  style="
    --zx-visible: {{ section.settings.visible_items }};
    --zx-visible-mobile: {{ section.settings.visible_items_mobile }};
    --zx-ratio: {{ section.settings.aspect_ratio }};
    padding-block: {{ section.settings.padding-block-start }}px {{ section.settings.padding-block-end }}px;
    {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
  "
>
  <zx-scroller class="zx-strip__scroller">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="zx-strip__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="zx-strip__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="zx-strip__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.show_arrows -%}
          <div class="zx-strip__arrows">
            <button type="button" class="zx-strip__arrow button-unstyled" data-zx-prev aria-label="{{ 'accessibility.slideshow_previous' | t }}">
              <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg>
            </button>
            <button type="button" class="zx-strip__arrow button-unstyled" data-zx-next aria-label="{{ 'accessibility.slideshow_next' | t }}">
              <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="zx-strip__track list-unstyled" data-zx-track role="list">
      {%- for block in section.blocks -%}
        <li class="zx-strip__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a class="zx-strip__card" href="{{ block.settings.link }}">
          {%- else -%}
            <div class="zx-strip__card">
          {%- endif -%}
          <div class="zx-strip__media">
            {%- if block.settings.video != blank -%}
              {{
                block.settings.video
                | video_tag:
                  class: 'zx-strip__asset',
                  image_size: '800x',
                  autoplay: true,
                  loop: true,
                  muted: true,
                  playsinline: true,
                  controls: false
              }}
            {%- elsif block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  class: 'zx-strip__asset',
                  widths: '300, 450, 600, 900',
                  sizes: '(min-width: 990px) 20vw, 50vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt | default: block.settings.caption
              }}
            {%- else -%}
              {%- liquid
                assign placeholders = 'lifestyle-1,lifestyle-2,collection-apparel-1,collection-apparel-2' | split: ','
                assign placeholder_index = forloop.index0 | modulo: placeholders.size
              -%}
              {{ placeholders[placeholder_index] | placeholder_svg_tag: 'zx-strip__asset zx-strip__asset--placeholder' }}
            {%- endif -%}
          </div>
          {%- if block.settings.caption != blank or block.settings.subcaption != blank -%}
            <span class="zx-strip__caption">
              {%- if block.settings.caption != blank -%}
                <span class="zx-strip__caption-title">{{ block.settings.caption }}</span>
              {%- endif -%}
              {%- if block.settings.subcaption != blank -%}
                <span class="zx-strip__caption-sub">{{ block.settings.subcaption }}</span>
              {%- endif -%}
            </span>
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </zx-scroller>
</div>

{% stylesheet %}
  .zx-strip__header {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0 var(--page-margin, 16px) 20px;
    text-align: center;
  }

  .zx-strip__heading {
    margin: 0;
    font-size: clamp(14px, 1.3vw, 18px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .zx-strip__subheading {
    margin: 0;
    font-size: 12px;
    color: var(--zx-muted, #6b6b6b);
  }

  .zx-strip__arrows {
    display: flex;
    gap: 8px;
    align-self: flex-end;
  }

  @media screen and (min-width: 750px) {
    .zx-strip__arrows {
      position: absolute;
      inset-inline-end: var(--page-margin, 16px);
      bottom: 20px;
    }
  }

  .zx-strip__arrow {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    cursor: pointer;
  }

  .zx-strip__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  zx-scroller:not([data-overflowing]) .zx-strip__arrows {
    visibility: hidden;
  }

  .zx-strip__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc(100% / var(--zx-visible-mobile));
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .zx-strip__track::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .zx-strip__track {
      grid-auto-columns: calc(100% / var(--zx-visible));
    }
  }

  .zx-strip__item {
    scroll-snap-align: start;
  }

  .zx-strip__card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .zx-strip__media {
    position: relative;
    aspect-ratio: var(--zx-ratio);
    overflow: hidden;
    background: var(--zx-card-media-bg, #f2f2f2);
  }

  .zx-strip__asset {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 0.4s ease;
  }

  .zx-strip__asset--placeholder {
    fill: rgb(0 0 0 / 0.25);
  }

  .zx-strip--grayscale .zx-strip__asset {
    filter: grayscale(1);
  }

  @media (hover: hover) {
    .zx-strip--grayscale .zx-strip__card:hover .zx-strip__asset {
      filter: grayscale(0);
    }
  }

  .zx-strip__caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 6px 0;
  }

  .zx-strip__caption-title {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .zx-strip__caption-sub {
    font-size: 10px;
    color: var(--zx-muted, #6b6b6b);
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:zx_names.media_strip",
  "tag": "section",
  "class": "zx-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:zx_settings.heading",
      "default": "Trusted by parents, loved by kids"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:zx_settings.subheading"
    },
    {
      "type": "range",
      "id": "visible_items",
      "label": "t:zx_settings.visible_items",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "visible_items_mobile",
      "label": "t:zx_settings.visible_items_mobile",
      "options": [
        { "value": "1.3", "label": "t:zx_options.one" },
        { "value": "2.2", "label": "t:zx_options.two" }
      ],
      "default": "2.2"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:zx_settings.aspect_ratio",
      "options": [
        { "value": "9 / 16", "label": "t:zx_options.story" },
        { "value": "2 / 3", "label": "t:zx_options.tall" },
        { "value": "3 / 4", "label": "t:zx_options.portrait" },
        { "value": "1 / 1", "label": "t:zx_options.square" },
        { "value": "4 / 3", "label": "t:zx_options.landscape" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "t:zx_settings.grayscale",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:zx_settings.show_arrows",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:zx_settings.background_color"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:zx_settings.top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:zx_settings.bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:zx_names.media_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:zx_settings.image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:zx_settings.video",
          "info": "t:zx_info.video_autoplay"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:zx_settings.caption"
        },
        {
          "type": "text",
          "id": "subcaption",
          "label": "t:zx_settings.subcaption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:zx_settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:zx_names.media_strip",
      "category": "t:zx_names.category",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
