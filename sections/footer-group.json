          "settings": { "content_direction": "column", "vertical_on_mobile": true, "horizontal_alignment": "flex-start", "vertical_alignment": "center", "gap": 10, "width": "fill" },
          "blocks": {
            "mission_heading": { "type": "text", "settings": { "text": "<h4>Our Mission</h4>", "width": "100%", "alignment": "left", "type_preset": "h4" } },
            "mission_text": { "type": "text", "settings": { "text": "<p>Kidsora House was born out of a desire to provide high-quality, stylish and affordable clothing for kids. We take pride in genuinely caring for our customers and their little ones, and we hope to keep growing with your family for years to come.</p>", "width": "100%", "alignment": "left", "type_preset": "rte" } }
          },
          "block_order": ["mission_heading", "mission_text"]
        }
      },
      "block_order": ["shop_menu", "help_menu", "mission"],
