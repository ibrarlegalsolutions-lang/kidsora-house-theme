{% javascript %}
  (function () {
    if (customElements.get('kidsora-scroll-hero')) return;

    class KidsoraScrollHero extends HTMLElement {
      connectedCallback() {
        this.count = parseInt(this.dataset.count, 10) || 0;
        if (this.count < 1) return;

        this.index = 0;
        this.mode = this.dataset.mode || 'scroll';
        this.stage = this.querySelector('[data-kx-stage]');
        this.status = this.querySelector('[data-kx-status]');
        this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.desktopQuery = window.matchMedia('(min-width: 750px)');
        this.items = [];
        for (let i = 0; i < this.count; i++) {
          this.items.push(Array.from(this.querySelectorAll('[data-kx-index="' + i + '"]')));
        }
        this.thumbs = Array.from(this.querySelectorAll('[data-kx-thumb]'));

        this.onScroll = this.onScroll.bind(this);
        this.onClick = this.onClick.bind(this);
        this.onKeydown = this.onKeydown.bind(this);
        this.onBlockSelect = this.onBlockSelect.bind(this);
        this.onBlockDeselect = this.onBlockDeselect.bind(this);
        this.onModeChange = this.onModeChange.bind(this);
        this.onVisibility = this.onVisibility.bind(this);
        this.onPointerDown = this.onPointerDown.bind(this);
        this.onPointerUp = this.onPointerUp.bind(this);
        this.pause = this.pause.bind(this);
        this.resume = this.resume.bind(this);

        this.addEventListener('click', this.onClick);
        this.addEventListener('keydown', this.onKeydown);
        this.addEventListener('mouseenter', this.pause);
        this.addEventListener('mouseleave', this.resume);
        this.addEventListener('focusin', this.pause);
        this.addEventListener('focusout', this.resume);
        this.stage.addEventListener('pointerdown', this.onPointerDown);
        this.stage.addEventListener('pointerup', this.onPointerUp);
        document.addEventListener('shopify:block:select', this.onBlockSelect);
        document.addEventListener('shopify:block:deselect', this.onBlockDeselect);
        document.addEventListener('visibilitychange', this.onVisibility);
        // Capture phase catches scrolling of any element (Horizon scrolls .page-wrapper on desktop)
        document.addEventListener('scroll', this.onScroll, { capture: true, passive: true });
        window.addEventListener('resize', this.onScroll, { passive: true });
        if (this.desktopQuery.addEventListener) {
          this.desktopQuery.addEventListener('change', this.onModeChange);
        }

        if ('IntersectionObserver' in window) {
          this.observer = new IntersectionObserver((entries) => {
            this.inView = entries[0].isIntersecting;
            this.inView ? this.resume() : this.pause();
          });
          this.observer.observe(this);
        } else {
          this.inView = true;
        }

        this.onModeChange();
      }

      disconnectedCallback() {
        this.stopAutoplay();
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
        document.removeEventListener('shopify:block:deselect', this.onBlockDeselect);
        document.removeEventListener('visibilitychange', this.onVisibility);
        document.removeEventListener('scroll', this.onScroll, { capture: true });
        window.removeEventListener('resize', this.onScroll);
        if (this.desktopQuery && this.desktopQuery.removeEventListener) {
          this.desktopQuery.removeEventListener('change', this.onModeChange);
        }
        if (this.observer) this.observer.disconnect();
      }

      /* ---------- Mode ---------- */

      get scrollActive() {
        if (this.mode !== 'scroll' || this.count < 2) return false;
        return this.dataset.scrollMobile === 'true' || this.desktopQuery.matches;
      }

      get autoplayActive() {
        if (this.count < 2) return false;
        // Scroll mode switched off on mobile falls back to autoplay
        return this.mode === 'autoplay' || (this.mode === 'scroll' && !this.scrollActive);
      }

      onModeChange() {
        this.stopAutoplay();
        if (this.scrollActive) {
          this.updateFromScroll();
        } else {
          this.startAutoplay();
        }
      }

      /* ---------- Slide change ---------- */

      goTo(target, dir) {
        if (this.count < 2) return;
        const next = ((target % this.count) + this.count) % this.count;
        if (next === this.index) return;

        const prev = this.index;
        this.dataset.dir = dir || (next > prev ? 'next' : 'prev');
        this.index = next;

        const outs = this.items[prev];
        const ins = this.items[next];
        const instantEls = [];

        ins.forEach((el) => {
          const type = el.dataset.kxType;
          const out = outs.find((o) => o.dataset.kxType === type);

          if ((type === 'info' || type === 'aside') && out && out.dataset.sig === el.dataset.sig) {
            el.classList.add('kx-instant');
            out.classList.add('kx-instant');
            instantEls.push(el, out);
          }

          if (type === 'img') {
            clearTimeout(el._kxTimer);
            el.classList.remove('is-leaving');
            el.classList.add('is-before');
            void el.offsetWidth; // commit the start position
            el.classList.remove('is-before');
            el.removeAttribute('aria-hidden');
          }

          el.classList.add('is-active');
        });

        outs.forEach((el) => {
          el.classList.remove('is-active');
          if (el.dataset.kxType === 'img') {
            el.setAttribute('aria-hidden', 'true');
            el.classList.add('is-leaving');
            clearTimeout(el._kxTimer);
            el._kxTimer = setTimeout(() => el.classList.remove('is-leaving'), 1100);
          }
        });

        if (instantEls.length) {
          requestAnimationFrame(() => {
            requestAnimationFrame(() => instantEls.forEach((el) => el.classList.remove('kx-instant')));
          });
        }

        const bg = ins.find((el) => el.dataset.kxType === 'bg');
        if (bg) {
          this.style.setProperty('--kx-fg', bg.dataset.fg);
          this.style.setProperty('--kx-contrast', bg.dataset.contrast);
        }

        const nextThumb = (next + 1) % this.count;
        this.thumbs.forEach((thumb) => {
          thumb.classList.toggle('is-active', parseInt(thumb.dataset.kxThumb, 10) === nextThumb);
        });

        if (this.status) this.status.textContent = 'Slide ' + (next + 1) + ' of ' + this.count;
      }

      step(delta) {
        if (this.scrollActive) {
          this.scrollToIndex(this.index + delta);
        } else {
          this.goTo(this.index + delta, delta > 0 ? 'next' : 'prev');
          this.restartAutoplay();
        }
      }

      /* ---------- Scroll-driven ---------- */

      onScroll() {
        if (!this.scrollActive || this.ticking) return;
        this.ticking = true;
        requestAnimationFrame(() => {
          this.ticking = false;
          this.updateFromScroll();
        });
      }

      getScrollDistance() {
        return this.offsetHeight - this.stage.offsetHeight;
      }

      updateFromScroll() {
        if (!this.scrollActive) return;
        const distance = this.getScrollDistance();
        if (distance <= 1) return;
        const top = this.getBoundingClientRect().top;
        const progress = Math.min(1, Math.max(0, -top / distance));
        const target = Math.min(this.count - 1, Math.floor(progress * this.count));
        this.style.setProperty('--kx-progress', progress.toFixed(4));
        if (target !== this.index) this.goTo(target, target > this.index ? 'next' : 'prev');
      }

      getScroller() {
        let el = this.parentElement;
        while (el && el !== document.body && el !== document.documentElement) {
          const overflowY = getComputedStyle(el).overflowY;
          if ((overflowY === 'auto' || overflowY === 'scroll') && el.scrollHeight > el.clientHeight) return el;
          el = el.parentElement;
        }
        return window;
      }

      scrollToIndex(target) {
        const distance = this.getScrollDistance();
        const top = this.getBoundingClientRect().top;
        let delta;
        if (target >= this.count) {
          delta = distance + top + 2; // scroll past the hero
        } else if (target < 0) {
          delta = top; // back to the start of the hero
        } else {
          delta = ((target + 0.5) / this.count) * distance + top;
        }
        this.getScroller().scrollBy({
          top: delta,
          behavior: this.reducedMotion.matches ? 'auto' : 'smooth',
        });
      }

      /* ---------- Autoplay ---------- */

      startAutoplay() {
        if (!this.autoplayActive || this.reducedMotion.matches) return;
        this.stopAutoplay();
        const speed = (parseFloat(this.dataset.autoplaySpeed) || 5) * 1000;
        this.timer = setInterval(() => this.goTo(this.index + 1, 'next'), speed);
      }

      stopAutoplay() {
        clearInterval(this.timer);
        this.timer = null;
      }

      restartAutoplay() {
        if (this.timer) this.startAutoplay();
      }

      pause() {
        this.paused = true;
        this.stopAutoplay();
      }

      resume() {
        if (this.editorLocked || this.inView === false || document.hidden) return;
        if (this.contains(document.activeElement) || this.matches(':hover')) return;
        this.paused = false;
        this.startAutoplay();
      }

      onVisibility() {
        document.hidden ? this.stopAutoplay() : this.resume();
      }

      /* ---------- Interaction ---------- */

      onClick(event) {
        const prevBtn = event.target.closest('[data-kx-prev]');
        const nextBtn = event.target.closest('[data-kx-next]');
        const sizeBtn = event.target.closest('[data-kx-size]');

        if (prevBtn) {
          event.preventDefault();
          this.step(-1);
        } else if (nextBtn) {
          event.preventDefault();
          this.step(1);
        } else if (sizeBtn) {
          this.selectSize(sizeBtn);
        }
      }

      selectSize(button) {
        const panel = button.closest('[data-kx-type="aside"]');
        if (!panel) return;
        panel.querySelectorAll('[data-kx-size]').forEach((btn) => {
          btn.setAttribute('aria-pressed', btn === button ? 'true' : 'false');
        });

        if (button.dataset.price) {
          const price = panel.querySelector('[data-kx-price]');
          if (price) price.textContent = button.dataset.price;
          const compare = panel.querySelector('[data-kx-compare]');
          if (compare) {
            compare.textContent = button.dataset.compare || '';
            compare.parentElement.hidden = !button.dataset.compare;
          }
        }

        if (button.dataset.url) {
          const info = this.querySelector(
            '[data-kx-type="info"][data-kx-index="' + panel.dataset.kxIndex + '"] [data-kx-cta-dynamic]'
          );
          if (info) info.setAttribute('href', button.dataset.url);
        }
      }

      onKeydown(event) {
        if (event.target.matches('input, textarea, select')) return;
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          this.step(-1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          this.step(1);
        }
      }

      onPointerDown(event) {
        if (this.scrollActive || event.pointerType === 'mouse') return;
        this.startX = event.clientX;
        this.startY = event.clientY;
      }

      onPointerUp(event) {
        if (this.startX == null) return;
        const dx = event.clientX - this.startX;
        const dy = event.clientY - this.startY;
        this.startX = null;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) this.step(dx < 0 ? 1 : -1);
      }

      /* ---------- Theme editor ---------- */

      onBlockSelect(event) {
        if (!this.contains(event.target)) return;
        const index = parseInt(event.target.dataset.kxIndex, 10);
        if (isNaN(index)) return;
        this.editorLocked = true;
        this.stopAutoplay();
        if (this.scrollActive) {
          this.scrollToIndex(index);
        } else {
          this.goTo(index, index > this.index ? 'next' : 'prev');
        }
      }

      onBlockDeselect(event) {
        if (!this.contains(event.target)) return;
        this.editorLocked = false;
        this.resume();
      }
    }

    customElements.define('kidsora-scroll-hero', KidsoraScrollHero);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Kidsora scroll hero",
  "tag": "section",
  "class": "kx-hero-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_mode",
      "label": "Slide change",
      "options": [
        { "value": "scroll", "label": "On scroll (pinned)" },
        { "value": "autoplay", "label": "Autoplay" },
        { "value": "manual", "label": "Arrows only" }
      ],
      "default": "scroll"
    },
    {
      "type": "range",
      "id": "scroll_length",
      "label": "Scroll distance per slide",
      "min": 40,
      "max": 150,
      "step": 10,
      "unit": "vh",
      "default": 80,
      "info": "Used when slides change on scroll"
    },
    {
      "type": "checkbox",
      "id": "scroll_mobile",
      "label": "Change slides on scroll on mobile",
      "default": true,
      "info": "When off, mobile uses autoplay instead"
    },
