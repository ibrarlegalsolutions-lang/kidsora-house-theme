<div
  class="zx-features"
  style="
    --zx-columns: {{ section.blocks.size | at_least: 1 }};
    padding-block: {{ section.settings.padding-block-start }}px {{ section.settings.padding-block-end }}px;
    {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
  "
>
  <ul class="zx-features__list list-unstyled" role="list">
    {%- for block in section.blocks -%}
      <li class="zx-features__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          {{
            block.settings.icon
            | image_url: width: 160
            | image_tag:
              class: 'zx-features__icon',
              widths: '80, 160',
              sizes: '40px',
              loading: 'lazy',
              alt: ''
          }}
        {%- else -%}
          <span class="zx-features__dot" style="background: {{ block.settings.accent_color }};" aria-hidden="true"></span>
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <h3 class="zx-features__title" style="color: {{ block.settings.accent_color }};">{{ block.settings.title }}</h3>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <p class="zx-features__text" style="color: {{ block.settings.accent_color }};">{{ block.settings.text }}</p>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .zx-features__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    width: min(100% - 2 * var(--page-margin, 16px), 1100px);
    margin: 0 auto;
    padding: 0;
  }

  @media screen and (min-width: 750px) {
    .zx-features__list {
      grid-template-columns: repeat(var(--zx-columns), minmax(0, 1fr));
    }
  }

  .zx-features__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .zx-features__icon {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .zx-features__dot {
    width: 32px;
    height: 32px;
    border-radius: 50%;
  }

  .zx-features__title {
    margin: 4px 0 0;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .zx-features__text {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:zx_names.feature_columns",
  "tag": "section",
  "class": "zx-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:zx_settings.background_color"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:zx_settings.top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:zx_settings.bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:zx_names.feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:zx_settings.icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:zx_settings.heading",
          "default": "Made for play"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:zx_settings.text",
          "default": "Comfy clothes that move with them"
        },
        {
          "type": "color",
          "id": "accent_color",
          "label": "t:zx_settings.accent_color",
          "default": "#E8B923"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:zx_names.feature_columns",
      "category": "t:zx_names.category",
      "blocks": [
        { "type": "feature", "settings": { "title": "Made for play", "text": "Comfy clothes that move with them", "accent_color": "#E8B923" } },
        { "type": "feature", "settings": { "title": "Gentle materials", "text": "Natural and breathable fabrics", "accent_color": "#B1141B" } },
        { "type": "feature", "settings": { "title": "Soft & stretchy", "text": "Easy and fun styles to wear", "accent_color": "#008083" } }
      ]
    }
  ]
}
{% endschema %}
