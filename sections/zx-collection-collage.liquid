{%- liquid
  assign tiles = section.blocks
-%}

<div class="zx-collage section section--full-width section--full-width-margin">
  <div class="zx-collage__grid">
    {%- for column in (1..3) -%}
      <div class="zx-collage__col zx-collage__col--{{ column }}">
        {%- for block in tiles -%}
          {%- liquid
            assign block_column = block.settings.column | plus: 0
            if block_column != column
              continue
            endif
            assign url = block.settings.link
            if url == blank and block.settings.collection != blank
              assign url = block.settings.collection.url
            endif
            assign image = block.settings.image
            if image == blank and block.settings.collection != blank
              assign image = block.settings.collection.featured_image
            endif
          -%}
          <div class="zx-collage__tile zx-collage__tile--{{ block.settings.label_style }}" {{ block.shopify_attributes }}>
            <a
              class="zx-collage__media"
              {% if url != blank %}href="{{ url }}"{% endif %}
              style="--zx-tile-ratio: {{ block.settings.aspect_ratio }};"
            >
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 480, 600, 800, 1000, 1200',
                    sizes: '(min-width: 750px) 33vw, 100vw',
                    alt: block.settings.label
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'zx-collage__placeholder' }}
              {%- endif -%}
              {%- if block.settings.label != blank and block.settings.label_style == 'overlay' -%}
                <span class="zx-collage__badge">{{ block.settings.label }}</span>
              {%- endif -%}
            </a>
            {%- if block.settings.label != blank and block.settings.label_style == 'below' -%}
              <a class="zx-collage__caption" {% if url != blank %}href="{{ url }}"{% endif %}>{{ block.settings.label }}</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .zx-collage {
    padding-block: 24px 40px;
  }

  .zx-collage__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  .zx-collage__col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Tiles with a caption below fill their column so the caption sits on the shared bottom line */
  .zx-collage__tile--below {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1 1 auto;
    gap: 16px;
  }

  .zx-collage__media {
    position: relative;
    display: block;
    aspect-ratio: var(--zx-tile-ratio);
    overflow: hidden;
    border-radius: 8px;
    background: #f3f3f3;
    color: inherit;
  }

  .zx-collage__media img,
  .zx-collage__media .zx-collage__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .zx-collage__media:hover img {
    transform: scale(1.03);
  }

  .zx-collage__badge {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    padding: 7px 16px;
    background: #fff;
    color: #111;
    font-family: var(--font-body--family);
    font-size: 11px;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .zx-collage__caption {
    display: block;
    text-align: center;
    font-family: var(--font-body--family);
    font-size: 12px;
    color: #111;
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    .zx-collage__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .zx-collage__col {
      gap: 12px;
    }

    .zx-collage__col--2 {
      grid-column: 1 / -1;
      flex-direction: row;
    }

    .zx-collage__col--2 > * {
      flex: 1 1 0;
    }

    .zx-collage__col--3 {
      grid-row: 1;
      grid-column: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection collage",
  "tag": "section",
  "class": "zx-collage-section",
  "max_blocks": 9,
  "settings": [],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Defaults to the collection image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Defaults to the collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "select",
          "id": "label_style",
          "label": "Label position",
          "options": [
            { "value": "overlay", "label": "On image" },
            { "value": "below", "label": "Below column" }
          ],
          "default": "overlay"
        },
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "options": [
            { "value": "1", "label": "Left" },
            { "value": "2", "label": "Middle" },
            { "value": "3", "label": "Right" }
          ],
          "default": "1"
        },
        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "Image shape",
          "options": [
            { "value": "2 / 3", "label": "Tall (2:3)" },
            { "value": "3 / 4", "label": "Portrait (3:4)" },
            { "value": "1 / 1", "label": "Square" },
            { "value": "4 / 3", "label": "Landscape" }
          ],
          "default": "3 / 4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection collage",
      "blocks": [
        { "type": "tile", "settings": { "label": "Boys", "label_style": "below", "column": "1", "aspect_ratio": "2 / 3" } },
        { "type": "tile", "settings": { "label": "Winter", "label_style": "overlay", "column": "2", "aspect_ratio": "3 / 4" } },
        { "type": "tile", "settings": { "label": "Summer", "label_style": "overlay", "column": "2", "aspect_ratio": "3 / 4" } },
        { "type": "tile", "settings": { "label": "Girls", "label_style": "below", "column": "3", "aspect_ratio": "2 / 3" } }
      ]
    }
  ]
}
{% endschema %}
