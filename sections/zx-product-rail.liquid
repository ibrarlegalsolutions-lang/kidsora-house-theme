{%- liquid
  assign source = section.settings.source
  assign limit = section.settings.limit
  assign recos_mode = false
  if source == 'recommendations'
    assign recos_mode = true
  endif
-%}
<section class="zx-section zx-rail" style="--zx-rail-pt: {{ section.settings.padding_top }}px; --zx-rail-pb: {{ section.settings.padding_bottom }}px;">
  <zx-rail
    class="zx-rail__root"
    {% if recos_mode and recommendations.performed? == false and product %}
      data-recos-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent={{ section.settings.intent }}"
    {% endif %}
  >
    <div class="zx-rail__head zx-wrap">
      {%- if section.settings.heading != blank -%}<h2 class="zx-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.show_arrows -%}
        <div class="zx-rail__arrows">
          <button type="button" class="zx-rail__arrow" data-dir="-1" aria-label="Previous">{% render 'zx-icon', icon: 'chevron-left' %}</button>
          <button type="button" class="zx-rail__arrow" data-dir="1" aria-label="Next">{% render 'zx-icon', icon: 'chevron-right' %}</button>
        </div>
      {%- endif -%}
    </div>
    <ul class="zx-rail__track zx-wrap" role="list">
      {%- liquid
        if recos_mode
          if recommendations.performed?
            for p in recommendations.products
              echo '<li class="zx-rail__item">'
              render 'zx-product-card', product: p, show_subtitle: section.settings.show_subtitle, choose_label: section.settings.choose_label, add_label: section.settings.add_label
              echo '</li>'
            endfor
          endif
        elsif section.settings.collection != blank
          for p in section.settings.collection.products limit: limit
            echo '<li class="zx-rail__item">'
            render 'zx-product-card', product: p, show_subtitle: section.settings.show_subtitle, choose_label: section.settings.choose_label, add_label: section.settings.add_label
            echo '</li>'
          endfor
        else
          for i in (1..6)
            echo '<li class="zx-rail__item">'
            render 'zx-product-card', product: blank, show_subtitle: section.settings.show_subtitle, choose_label: section.settings.choose_label, add_label: section.settings.add_label
            echo '</li>'
          endfor
        endif
      -%}
    </ul>
    {%- if section.settings.link_label != blank -%}
      <div class="zx-rail__foot">
        <a class="zx-link" href="{{ section.settings.link | default: section.settings.collection.url | default: '#' }}">{{ section.settings.link_label | escape }}</a>
      </div>
    {%- endif -%}
  </zx-rail>
</section>

<script type="module">
  if (!customElements.get('zx-rail')) {
    customElements.define('zx-rail', class extends HTMLElement {
      connectedCallback() {
        this.addEventListener('click', (e) => {
          const btn = e.target.closest('.zx-rail__arrow');
          if (!btn) return;
          const track = this.querySelector('.zx-rail__track');
          const item = track.querySelector('.zx-rail__item');
          const step = item ? item.getBoundingClientRect().width + 8 : 258;
          track.scrollBy({ left: step * Number(btn.dataset.dir) * Math.max(1, Math.floor(track.clientWidth / step) - 1), behavior: 'smooth' });
        });
        const url = this.dataset.recosUrl;
        if (url && !this.dataset.loaded) {
          this.dataset.loaded = 'true';
          fetch(url)
            .then((r) => r.text())
            .then((html) => {
              const doc = new DOMParser().parseFromString(html, 'text/html');
              const fresh = doc.querySelector('zx-rail .zx-rail__track');
              const track = this.querySelector('.zx-rail__track');
              if (fresh && fresh.children.length) {
                track.replaceChildren(...fresh.children);
              } else {
                this.closest('.shopify-section')?.setAttribute('hidden', '');
              }
            })
            .catch(() => {});
        }
      }
    });
  }
</script>

{% stylesheet %}
  .zx-rail { padding: var(--zx-rail-pt) 0 var(--zx-rail-pb); }
  .zx-rail__head { position: relative; }
  .zx-rail__arrows { position: absolute; right: var(--zx-gutter); top: 0; display: flex; gap: 16px; }
  .zx-rail__arrow { width: 32px; height: 32px; padding: 4px; border: 0; background: none; color: var(--zx-ink); cursor: pointer; }
  .zx-rail__track {
    list-style: none; margin: 0;
    display: grid; grid-auto-flow: column; grid-auto-columns: 250px; gap: 8px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--zx-gutter);
    scrollbar-width: none;
  }
  .zx-rail__track::-webkit-scrollbar { display: none; }
  .zx-rail__item { scroll-snap-align: start; }
  .zx-rail__foot { text-align: center; margin-top: 40px; }
  .zx-rail__foot .zx-link { font-size: 16px; }
  @media (min-width: 1700px) { .zx-rail__track { grid-auto-columns: calc((100% - 2 * var(--zx-gutter) - 40px) / 6); } }
  @media (max-width: 749px) {
    .zx-rail__arrows { display: none; }
    .zx-rail__track { grid-auto-columns: 42%; }
    .zx-rail__foot { margin-top: 24px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ZX Product rail",
  "class": "zx-rail-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop Best Sellers" },
    { "type": "select", "id": "source", "label": "Products", "default": "collection", "options": [
      { "value": "collection", "label": "Collection" },
      { "value": "recommendations", "label": "Product recommendations (product pages)" }
    ] },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "select", "id": "intent", "label": "Recommendation type", "default": "related", "options": [
      { "value": "related", "label": "Related" },
      { "value": "complementary", "label": "Complementary (set up in Search & Discovery)" }
    ] },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 16, "step": 1, "default": 10 },
    { "type": "checkbox", "id": "show_subtitle", "label": "Show product type under title", "default": true },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    { "type": "text", "id": "choose_label", "label": "Multi-variant button label", "default": "Choose shades" },
    { "type": "text", "id": "add_label", "label": "Single-variant button label", "default": "Add to bag" },
    { "type": "text", "id": "link_label", "label": "Bottom link label", "default": "Shop Best Sellers" },
    { "type": "url", "id": "link", "label": "Bottom link", "info": "Defaults to the collection" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "ZX Product rail" }]
}
{% endschema %}
