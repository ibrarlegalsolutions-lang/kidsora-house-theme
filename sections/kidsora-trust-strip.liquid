<section class="kp-trust kp-trust--{{ section.id }}" style="--kp-bg:{{ section.settings.background }};--kp-fg:{{ section.settings.text_color }};--kp-gap:{{ section.settings.gap }}px;--kp-cols:{{ section.blocks.size }}">
  <div class="kp-trust__inner">
    {% if section.settings.heading != blank %}
      <div class="kp-trust__heading">{{ section.settings.heading }}</div>
    {% endif %}
    <div class="kp-trust__grid">
      {% for block in section.blocks %}
        <article class="kp-trust__item" {{ block.shopify_attributes }}>
          <span class="kp-trust__icon" aria-hidden="true">{% render 'icon-or-image', icon: block.settings.icon, width: 28, class_name: 'kp-trust__icon-svg' %}</span>
          <div><strong>{{ block.settings.heading | escape }}</strong>{% if block.settings.text != blank %}<span>{{ block.settings.text | escape }}</span>{% endif %}</div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% stylesheet %}
  .kp-trust{background:var(--kp-bg);color:var(--kp-fg);padding:clamp(48px,7vw,88px) 20px}
  .kp-trust__inner{max-width:1200px;margin:auto}
  .kp-trust__heading{max-width:26ch;margin:0 auto clamp(36px,6vw,60px);text-align:center;font-family:var(--font-heading--family);font-size:clamp(1.6rem,3.2vw,2.6rem);line-height:1.3;font-weight:400;letter-spacing:-.01em}
  .kp-trust__grid{display:grid;grid-template-columns:repeat(var(--kp-cols,4),1fr);gap:var(--kp-gap)}
  .kp-trust__item{display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px;min-width:0}
  .kp-trust__icon{display:grid;place-items:center;width:52px;height:52px;flex:0 0 52px;border:1px solid currentColor;border-radius:50%}
  .kp-trust__icon-svg{width:22px;height:22px}
  .kp-trust__icon-svg svg{width:100%;height:100%;fill:none;stroke:currentColor}
  .kp-trust__item strong{display:block;font-family:var(--font-heading--family);font-weight:600;font-size:1rem;letter-spacing:.01em}
  .kp-trust__item span{display:block;font-size:.82rem;opacity:.75;margin-top:4px}
  @media(max-width:749px){.kp-trust__grid{grid-template-columns:repeat(2,1fr);row-gap:32px}}
  @media(max-width:479px){.kp-trust__grid{grid-template-columns:1fr}}
{% endstylesheet %}
{% schema %}
{"name":"Kidsora trust strip","max_blocks":6,"settings":[{"type":"richtext","id":"heading","label":"Statement heading (optional)"},{"type":"color","id":"background","label":"Background","default":"#5B7075"},{"type":"color","id":"text_color","label":"Text","default":"#F8F3EA"},{"type":"range","id":"gap","label":"Gap","min":8,"max":48,"step":4,"unit":"px","default":24}],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"none","label":"None"},{"value":"box","label":"Box"},{"value":"check_box","label":"Check"},{"value":"eye","label":"Eye"},{"value":"heart","label":"Heart"},{"value":"leaf","label":"Leaf"},{"value":"lock","label":"Lock"},{"value":"map_pin","label":"Map pin"},{"value":"plane","label":"Plane"},{"value":"price_tag","label":"Price tag"},{"value":"question_mark","label":"Question mark"},{"value":"return","label":"Return"},{"value":"ruler","label":"Ruler"},{"value":"shirt","label":"Shirt"},{"value":"star","label":"Star"},{"value":"stopwatch","label":"Stopwatch"},{"value":"truck","label":"Truck"}],"default":"star"},{"type":"text","id":"heading","label":"Heading","default":"Quality checked"},{"type":"text","id":"text","label":"Supporting text"}]}],"presets":[{"name":"Kidsora trust strip","blocks":[{"type":"benefit"},{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}]}],"disabled_on":{"groups":["header","footer"]}}
{% endschema %}
