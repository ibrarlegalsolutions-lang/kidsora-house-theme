{%- liquid
  assign ratio = section.settings.desktop_height
  assign mratio = section.settings.mobile_height
-%}
<section class="zx-section zx-hero" style="--zx-hero-h: {{ ratio }}px; --zx-hero-mh: {{ mratio }}px; --zx-hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  {%- if section.settings.link != blank -%}<a class="zx-hero__link" href="{{ section.settings.link }}" aria-label="{{ section.settings.heading | strip_html | escape }}"></a>{%- endif -%}
  <div class="zx-hero__media">
    {%- if section.settings.image != blank -%}
      {%- assign mobile_image = section.settings.mobile_image | default: section.settings.image -%}
      <picture>
        <source media="(min-width: 750px)" srcset="{{ section.settings.image | image_url: width: 1440 }} 1440w, {{ section.settings.image | image_url: width: 2400 }} 2400w" sizes="100vw">
        {{ mobile_image | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '450, 750, 900', alt: section.settings.image.alt | escape }}
      </picture>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'zx-hero__placeholder' }}
    {%- endif -%}
  </div>
  <div class="zx-hero__content zx-hero__content--{{ section.settings.content_position }}">
    {%- if section.settings.eyebrow != blank -%}<p class="zx-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="zx-hero__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="zx-hero__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="zx-btn zx-btn--rose zx-hero__btn" href="{{ section.settings.link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .zx-hero { position: relative; overflow: hidden; height: var(--zx-hero-h); background: #6b0f1a; color: #fff; }
  .zx-hero__link { position: absolute; inset: 0; z-index: 2; }
  .zx-hero__media, .zx-hero__media picture, .zx-hero__media img, .zx-hero__placeholder { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .zx-hero__media::after { content: ''; position: absolute; inset: 0; background: rgba(0, 0, 0, var(--zx-hero-overlay)); }
  .zx-hero__content { position: absolute; z-index: 3; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; max-width: 46%; pointer-events: none; }
  .zx-hero__content a { pointer-events: auto; }
  .zx-hero__content--right { right: 4.5%; }
  .zx-hero__content--left { left: 4.5%; }
  .zx-hero__content--center { left: 50%; transform: translate(-50%, -50%); }
  .zx-hero__eyebrow { margin: 0; font-family: var(--zx-font-condensed); font-size: 16px; text-transform: uppercase; letter-spacing: 2px; }
  .zx-hero__heading { margin: 0; font-family: var(--zx-font-display); font-style: italic; font-weight: 400; font-size: clamp(48px, 9vw, 140px); line-height: .85; letter-spacing: 0; }
  .zx-hero__heading p { margin: 0; }
  .zx-hero__sub { margin: 0; font-family: var(--zx-font-condensed); font-size: clamp(18px, 2vw, 30px); line-height: 1.1; text-transform: uppercase; letter-spacing: var(--zx-tracking); }
  .zx-hero__btn { min-width: 280px; min-height: 48px; }
  @media (max-width: 749px) {
    .zx-hero { height: var(--zx-hero-mh); }
    .zx-hero__content, .zx-hero__content--right, .zx-hero__content--left { left: 16px; right: 16px; top: auto; bottom: 24px; transform: none; max-width: none; }
    .zx-hero__btn { min-width: 0; width: 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ZX Hero banner",
  "tag": "div",
  "class": "zx-hero-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image", "info": "2880 × 1100 px recommended (approx. 2.6:1)" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "1170 × 1560 px recommended (3:4)" },
    { "type": "range", "id": "overlay", "label": "Image overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 300, "max": 900, "step": 10, "unit": "px", "default": 550 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 300, "max": 800, "step": 10, "unit": "px", "default": 520 },
    { "type": "select", "id": "content_position", "label": "Content position", "default": "right", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Gift more beauty</p>" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "More love, more magic, more joy!" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop gifts" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "ZX Hero banner" }]
}
{% endschema %}
